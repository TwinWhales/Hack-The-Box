<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <title>Blog</title>
    <script language="JavaScript"><!--
        function myFunction() {            
            document.getElementById("uploadxml").click()
        }
        function DialogClose() {
            document.getElementById("uploadform").action = "/articles/xml"
            document.getElementById("uploadform").onsubmit = ""
            document.getElementById("uploadform").submit()
        }
    //--></script>
</head>
<body>
    <div class="container">
        <h1 class="mb-4">Blog Articles</h1>
        <% if (authenticated) { %>
        <a href="/articles/new" class="btn btn-success">New Article</a>
        <form onsubmit="myFunction(); return false;" method="POST" id="uploadform" class="d-inline" enctype="multipart/form-data">
            <input type="file" name="file" id="uploadxml" onchange onpropertychange oninput="DialogClose();" style="display: none">
            <button class="btn btn-warning">Upload</button>
        </form>
        <% } else { %>
            <a href="/login" class="btn btn-success">Login</a>
        <% } %>
        <% articles.forEach(article => { %>
            <% if (article.ip == '::ffff:192.168.58.49' || article.ip == ip){ %>
            <div class ="card mt-4">
                <div class="card-body">
                    <h4 class="card-title"><%= article.title %></h4>
                    <div class="card-subtitle text-muted mb-2">
                        <%= article.createdAt.toLocaleDateString() %>
                    </div>
                    <div class="card-text mb-2"><%= article.description %></div>
                    <a href="articles/<%= article.slug %>" class="btn btn-primary">Read More</a>
                    <% if (authenticated) { %>
                    <a href="articles/edit/<%= article.id %>" class="btn btn-info">Edit</a>
                    <form action="/articles/<%= article.id %>?_method=DELETE" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                    <% } %>
                </div>
            </div>
            <% } %>
    <% }) %>
    </div>
</body>
</html>