                    Category="windows.protocol">
                    <uap:Protocol Name="webcals" />
                </uap:Extension>
                <uap:Extension
                    Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="ics" DesiredView="default">
