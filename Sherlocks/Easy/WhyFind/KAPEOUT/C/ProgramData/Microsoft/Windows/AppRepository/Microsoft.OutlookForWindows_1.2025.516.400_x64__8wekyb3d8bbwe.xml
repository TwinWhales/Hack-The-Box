                            <uap:FileType>.ics</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap:DisplayName>iCalendar File</uap:DisplayName>
                        <uap:Logo>Assets/CalendarIcon.png</uap:Logo>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <uap:Extension
                    Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="msg" DesiredView="default">
                        <uap:SupportedFileTypes>
                            <uap:FileType>.msg</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap:DisplayName>Outlook Item</uap:DisplayName>
                        <uap:Logo>Assets/MailIcon.png</uap:Logo>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <uap:Extension
                    Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="eml" DesiredView="default">
                        <uap:SupportedFileTypes>
                            <uap:FileType>.eml</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap:DisplayName>E-mail Message</uap:DisplayName>
                        <uap:Logo>Assets/MailIcon.png</uap:Logo>
                    </uap:FileTypeAssociation>
                </uap:Extension>
                <uap:Extension
                    Category="windows.fileTypeAssociation">
                    <uap:FileTypeAssociation Name="oft" DesiredView="default">
                        <uap:SupportedFileTypes>
                            <uap:FileType>.oft</uap:FileType>
                        </uap:SupportedFileTypes>
                        <uap:DisplayName>Outlook Item Template</uap:DisplayName>
                        <uap:Logo>Assets/MailIcon.png</uap:Logo>
                    </uap:FileTypeAssociation>
                </uap:Extension>
